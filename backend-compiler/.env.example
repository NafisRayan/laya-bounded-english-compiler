# Example environment for the backend-compiler harness tiers.
# Copy to `.env` and fill in values. Real credentials are never committed.
#
# LLM baselines (Paper §5.1): supplies the Gemini completer (REST, no SDK).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional alternative completers (used only when GEMINI is absent):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
#
# End-to-end tier (Paper §5.4): a real Supabase organization. Create a
# personal access token at https://supabase.com/dashboard/account/tokens and
# find your org slug under Account -> Organizations.
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORG_SLUG=
# Optional: region override for the e2e project fixture. Valid smart-group
# codes: americas | emea | apac (default apac).
# SUPABASE_REGION=apac