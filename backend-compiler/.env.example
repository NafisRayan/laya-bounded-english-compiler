# Example environment for the backend-compiler harness tiers.
# Copy to `.env` and fill in values. Real credentials are never committed.
#
# Preferred: ANY OpenAI-compatible gateway (OpenRouter, a proxy, vLLM, or
# Gemini's own /v1beta/openai shim). Takes precedence over the native keys.
# OPENAI_BASE_URL is the full prefix: the endpoint is {OPENAI_BASE_URL}/chat/completions.
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Model id as the gateway names it; falls back to GEMINI_MODEL, then gemini-2.5-flash.
# OPENAI_MODEL=gemini-3.5-flash
#
# Native Gemini REST (used when no gateway is configured).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional alternative completers (used only when the above are absent):
# ANTHROPIC_API_KEY=
#
# End-to-end tier (Paper §5.4): a real Supabase organization. Create a
# personal access token at https://supabase.com/dashboard/account/tokens and
# find your org slug under Account -> Organizations.
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORG_SLUG=
# Optional: region override for the e2e project fixture. Valid smart-group
# codes: americas | emea | apac (default apac).
# SUPABASE_REGION=apac